# ==============================================================================
# UniShare Labs - Backend Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave MONGODB_URI empty or set to "inmemory" to trigger automatic mongodb-memory-server
# To connect to external MongoDB: mongodb://localhost:27017/unishare_labs or mongodb+srv://...
MONGODB_URI=

# Authentication & JWT Secrets (Dual-Token Scheme)
# Generate secure random strings in production (e.g., openssl rand -base64 32)
JWT_SECRET=unishare_access_super_secret_jwt_key_2026_dev_min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=unishare_refresh_super_secret_jwt_key_2026_dev_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Client Integration
CORS_ORIGIN=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=20

# Optional Boot Seeding Trigger (true/false)
SEED_ON_BOOT=false
