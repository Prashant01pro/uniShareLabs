{
  "$schema": "https://schema.railway.app/railway.schema.json",
  "services": {
    "backend": {
      "source": {
        "repo": "."
      },
      "build": {
        "buildCommand": "npm --prefix backend install && npm --prefix backend run build",
        "watchPatterns": ["backend/**"]
      },
      "deploy": {
        "startCommand": "npm --prefix backend run start",
        "healthcheckPath": "/api/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    },
    "frontend": {
      "source": {
        "repo": "."
      },
      "build": {
        "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
        "watchPatterns": ["frontend/**"]
      },
      "deploy": {
        "startCommand": "npm --prefix frontend run preview",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    }
  }
}

